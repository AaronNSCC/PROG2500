<Application x:Class="a1_FitnessTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:a1_FitnessTracker"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
         <!-- COLOR PALETTE -->
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#DCE8F7" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F4F8FD" />
        <SolidColorBrush x:Key="TitleBrush" Color="#0B1F4A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2E5C9E" />
        <SolidColorBrush x:Key="TextBrush" Color="#1A2B4C" />
        <!-- FONT -->
        <FontFamily x:Key="AppFont">Bahnschrift Light</FontFamily>
    </Application.Resources>
</Application>
