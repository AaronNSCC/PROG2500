<Window x:Class="a1_FitnessTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:a1_FitnessTracker"
        mc:Ignorable="d"
        Title="Fitness Tracker" Height="450" Width="800">

    <!--STYLING-->
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5" />
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Fitness Tracker" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="5" />

        <!-- GROUPBOX SRC: https://wpf-tutorial.com/misc-controls/the-groupbox-control/ -->
        <!-- STRING FORMAT SRC: https://learn.microsoft.com/en-us/dotnet/api/system.windows.data.bindingbase.stringformat?view=windowsdesktop-10.0-->
        <!-- SUMMARY GROUP -->
        <GroupBox Header="Summary" Grid.Row="1" Grid.Column="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Content="Total Duration:" Grid.Row="0" Grid.Column="0" />
                <TextBlock Text="0 mins" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" />
                
                <Label Content="Total Calories Burned:" Grid.Row="1" Grid.Column="0" />
                <TextBlock Text="0 mins" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" />

                <Label Content="Goal Progress:" Grid.Row="2" Grid.Column="0" />
                <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MinutesGoal, StringFormat='0 / {0} mins, '}"/>
                    <TextBlock Text="{Binding CaloriesGoal, StringFormat='0 / {0} calories '}"/>
                </StackPanel>
            </Grid>
        </GroupBox>
        
        <!-- WEEKLY GOALS GROUP -->
        <GroupBox Header="Set Weekly Goals" Grid.Row="1" Grid.Column="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Content="Minutes Per Week:" Grid.Row="0" Grid.Column="0"/>
                <!--  UpdateSourceTrigger SRC: https://wpf-tutorial.com/data-binding/the-update-source-trigger-property/-->
                <TextBox x:Name="MinutesGoalTextBox" Text="{Binding MinutesGoal, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                         Grid.Row="0" Grid.Column="1"/>

                <Label Content="Calories Per Week:" Grid.Row="1" Grid.Column="0"/>
                <TextBox x:Name="CaloriesGoalTextBox" Text="{Binding CaloriesGoal, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                         Grid.Row="1" Grid.Column="1"/>

                <Button x:Name="SetGoalsButton" Content="Set Goals" Click="SetGoalsButton_Click" Grid.Row="2" Grid.Column="1"
                        Margin="0,10,0,0"/>
            </Grid>
        </GroupBox>

        <!-- EXISTING ACTIVITIES GROUP -->
        <GroupBox Header="Existing Activities" Grid.Row="2" Grid.Column="0">
            <ListView x:Name="ActivitiesListView">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Activity" />
                        <GridViewColumn Header="Minutes" />
                        <GridViewColumn Header="Calories" />
                        <GridViewColumn Header="Date" />
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>
        
        <!-- NEW ACTIVITY GROUP -->
        <GroupBox Header="New Activity" Grid.Row="2" Grid.Column="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Content="Activity Name:" Grid.Row="0" Grid.Column="0"/>
                    <TextBox x:Name="ActivityNameTextBox" Grid.Row="0" Grid.Column="1"/>

                    <Label Content="Time (minutes):" Grid.Row="1" Grid.Column="0"/>
                    <TextBox x:Name="ActivityMinutesTextBox" Grid.Row="1" Grid.Column="1"/>

                    <Label Content="Calories Burned:" Grid.Row="2" Grid.Column="0"/>
                    <TextBox x:Name="ActivityCaloriesTextBox" Grid.Row="2" Grid.Column="1"/>

                    <Label Content="Date:" Grid.Row="3" Grid.Column="0"/>
                    <TextBox x:Name="ActivityDateTextBox" Grid.Row="3" Grid.Column="1"/>

                    <Button x:Name="AddActivityButton" Content="Add Activity" Grid.Row="4" Grid.Column="1"
                            Margin="0,10,0,0"/>
                </Grid>
            </StackPanel>
        </GroupBox>

    </Grid>
</Window>
