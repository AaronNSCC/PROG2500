<Window x:Class="a1_FitnessTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:a1_FitnessTracker"
        mc:Ignorable="d"
        Title="Fitness Tracker" Height="450" Width="800" MinHeight="450" MinWidth="700"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="{StaticResource AppFont}" >

    <!--STYLING-->
    <Window.Resources>
        <!-- GROUPBOX -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TitleBrush}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- TITLE -->
        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TitleBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <!-- BUTTONS -->
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="100" />
            <!-- Rounds the button by styling the Border
            SRC: https://stackoverflow.com/questions/72325433/round-the-corners-of-a-button-in-window-resources-wpf -->
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6" />
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TitleBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Grey out Add Activity Btn if a field is missing -->
        <Style x:Key="AddActivityButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=ActivityNameTextBox}" Value="" >
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, ElementName=ActivityMinutesTextBox}" Value="" >
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, ElementName=ActivityCaloriesTextBox}" Value="" >
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDate, ElementName=ActivityDatePicker}" Value="{x:Null}" >
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SetGoalsButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=MinutesGoalTextBox}" Value="" >
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, ElementName=CaloriesGoalTextBox}" Value="" >
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RemoveActivityButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem, ElementName=ActivitiesListView}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- LABELS -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <!-- TEXT INPUTS -->
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <!-- SUMMARY VALUES -->
        <Style x:Key="SummaryValueStyle" TargetType="TextBlock" >
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="15,0,0,0" />
        </Style>
        <!-- PROGRESS BARS -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="15,2,15,2" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Fitness Tracker" Style="{StaticResource TitleTextStyle}"
                   Grid.Row="0" Grid.ColumnSpan="2" />

        <!-- GROUPBOX SRC: https://wpf-tutorial.com/misc-controls/the-groupbox-control/ -->
        <!-- STRING FORMAT SRC: https://learn.microsoft.com/en-us/dotnet/api/system.windows.data.bindingbase.stringformat?view=windowsdesktop-10.0-->
        <!-- SUMMARY GROUP -->
        <GroupBox Header="Summary" Grid.Row="1" Grid.Column="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Content="Total Duration:" Grid.Row="0" Grid.Column="0" />
                <TextBlock Text="{Binding TotalMinutes, StringFormat='{}{0} minutes'}"
                           Grid.Row="0" Grid.Column="1" Style="{StaticResource SummaryValueStyle}" />
                
                <Label Content="Total Calories Burned:" Grid.Row="1" Grid.Column="0" />
                <TextBlock Text="{Binding TotalCalories, StringFormat='{}{0} calories'}"
                           Grid.Row="1" Grid.Column="1" Style="{StaticResource SummaryValueStyle}" />

                <Label Content="Goal Progress:" Grid.Row="2" Grid.Column="0" />
                <TextBlock Text="{Binding GoalProgressText}"
                           Grid.Row="2" Grid.Column="1" Style="{StaticResource SummaryValueStyle}"/>

                <!-- PROGRESS BARS SRC: https://learn.microsoft.com/en-us/uwp/api/windows.ui.xaml.controls.progressbar?view=winrt-28000 -->
                <Label Content="Minutes Goal:" Grid.Row="3" Grid.Column="0" />
                <ProgressBar Value="{Binding TotalMinutes, Mode=OneWay}" Maximum="{Binding MinutesGoal}"
                             Grid.Row="3" Grid.Column="1" />

                <Label Content="Calories Goal:" Grid.Row="4" Grid.Column="0" />
                <ProgressBar Value="{Binding TotalCalories, Mode=OneWay}" Maximum="{Binding CaloriesGoal}"
                             Grid.Row="4" Grid.Column="1" />
            </Grid>
        </GroupBox>
        
        <!-- WEEKLY GOALS GROUP -->
        <GroupBox Header="Set Weekly Goals" Grid.Row="1" Grid.Column="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Content="Minutes Per Week:" Grid.Row="0" Grid.Column="0"/>
                <!--  UpdateSourceTrigger SRC: https://wpf-tutorial.com/data-binding/the-update-source-trigger-property/-->
                <TextBox x:Name="MinutesGoalTextBox" Text="{Binding MinutesGoal, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                         Grid.Row="0" Grid.Column="1"/>

                <Label Content="Calories Per Week:" Grid.Row="1" Grid.Column="0"/>
                <TextBox x:Name="CaloriesGoalTextBox" Text="{Binding CaloriesGoal, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                         Grid.Row="1" Grid.Column="1"/>

                <Button x:Name="SetGoalsButton" Content="Set Goals" Click="SetGoalsButton_Click"
                        Style="{StaticResource SetGoalsButtonStyle}"
                        Grid.Row="2" Grid.Column="1"/>
            </Grid>
        </GroupBox>

        <!-- EXISTING ACTIVITIES GROUP -->
        <GroupBox Header="Existing Activities" Grid.Row="2" Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <ListView x:Name="ActivitiesListView" ItemsSource="{Binding Activities}" Grid.Row="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Activity" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Minutes" DisplayMemberBinding="{Binding Minutes}" />
                            <GridViewColumn Header="Calories" DisplayMemberBinding="{Binding Calories}" />
                            <!--DateTime Format SRC: https://learn.microsoft.com/en-us/dotnet/desktop/wpf/advanced/datetime-xaml-syntax-->
                            <GridViewColumn Header="Date" DisplayMemberBinding="{Binding Date, StringFormat='MMM. d, yyyy'}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <Button x:Name="RemoveActivityButton" Content="Remove Activity" Click="RemoveActivityButton_Click"
                        Style="{StaticResource RemoveActivityButtonStyle}" Grid.Row="1" />

            </Grid>
        </GroupBox>
        
        <!-- NEW ACTIVITY GROUP -->
        <GroupBox Header="New Activity" Grid.Row="2" Grid.Column="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Content="Activity Name:" Grid.Row="0" Grid.Column="0"/>
                <TextBox x:Name="ActivityNameTextBox" Grid.Row="0" Grid.Column="1"/>

                <Label Content="Time (minutes):" Grid.Row="1" Grid.Column="0"/>
                <TextBox x:Name="ActivityMinutesTextBox" Grid.Row="1" Grid.Column="1"/>

                <Label Content="Calories Burned:" Grid.Row="2" Grid.Column="0"/>
                <TextBox x:Name="ActivityCaloriesTextBox" Grid.Row="2" Grid.Column="1"/>

                <!-- Date Picker SRC: https://learn.microsoft.com/en-us/dotnet/desktop/wpf/controls/datepicker -->
                <Label Content="Date:" Grid.Row="3" Grid.Column="0"/>
                <DatePicker x:Name="ActivityDatePicker" Grid.Row="3" Grid.Column="1"/>

                <Button x:Name="AddActivityButton" Content="Add Activity" Click="AddActivityButton_Click"
                            Style="{StaticResource AddActivityButtonStyle}"
                            Grid.Row="4" Grid.Column="1" />
            </Grid>
        </GroupBox>

    </Grid>
</Window>
