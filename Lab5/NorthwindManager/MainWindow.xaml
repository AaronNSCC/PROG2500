<Window x:Class="NorthwindManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Northwind Manager" Height="560" Width="820"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>

    <TabControl Margin="10">

        <!-- Products: list, search, and change a price -->
        <TabItem Header="Products">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Product name contains:" />
                    <TextBox x:Name="SearchBox" Width="220" />
                    <Button x:Name="SearchButton" Content="Search" Click="SearchButton_Click" />
                </StackPanel>

                <DataGrid x:Name="ProductsGrid" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="ProductsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ProductId}" Width="50" />
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" />
                        <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="90" />
                        <DataGridTextColumn Header="In Stock" Binding="{Binding UnitsInStock}" Width="70" />
                        <DataGridCheckBoxColumn Header="Discontinued" Binding="{Binding Discontinued}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Price for the selected product:" />
                    <TextBox x:Name="PriceBox" Width="100" />
                    <Button x:Name="SavePriceButton" Content="Save Price" Click="SavePriceButton_Click" />
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- Shippers: list, add and delete -->
        <TabItem Header="Shippers">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="ShippersGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ShipperId}" Width="50" />
                        <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="*" />
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Company:" />
                    <!-- MaxLength matches the column sizes in the database -->
                    <TextBox x:Name="CompanyBox" Width="200" MaxLength="40" />
                    <TextBlock Text="Phone:" Margin="12,0,6,0" />
                    <TextBox x:Name="PhoneBox" Width="130" MaxLength="24" />
                    <Button x:Name="AddShipperButton" Content="Add Shipper" Click="AddShipperButton_Click" />
                    <Button x:Name="DeleteShipperButton" Content="Delete Selected" Click="DeleteShipperButton_Click" Margin="24,0,0,0" />
                </StackPanel>
            </Grid>
        </TabItem>

    </TabControl>
</Window>
