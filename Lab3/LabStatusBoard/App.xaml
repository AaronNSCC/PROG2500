<Application x:Class="LabStatusBoard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LabStatusBoard"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- A few shared resources so the board has a consistent look.
             Feel free to add to these as you build your control. -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F5F7"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="White"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#D6D6D6"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6B6B6B"/>

    </Application.Resources>
</Application>
