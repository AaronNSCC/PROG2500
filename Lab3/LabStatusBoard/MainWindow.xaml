<Window x:Class="LabStatusBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabStatusBoard"
        xmlns:controls="clr-namespace:LabStatusBoard.Controls"
        mc:Ignorable="d"
        Title="Lab Status Board" Height="580" Width="940"
        Background="{StaticResource AppBackgroundBrush}">

    <!-- The controls: prefix on line 7 is already declared for you. That is how this
         file can say <controls:MachineTile .../> once you get there. -->

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="Lab Status Board" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="Refresh" Click="RefreshButton_Click" Margin="18,0,0,0" Padding="14,4" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">

            <!-- TODO 9
                 Attach ONE handler for the MachineSelected event, here on the ItemsControl,
                 not on each tile. The attribute goes on the line below and looks like:

                     controls:MachineTile.MachineSelected="OnMachineSelected"

                 That is the attached event syntax: the type that owns the event, a dot,
                 then the event name. -->
            <ItemsControl ItemsSource="{Binding Machines}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <!-- TODO 1
                             Replace this whole Border block with your MachineTile control,
                             feeding each of its three properties from the machine for this
                             item:

                                 <controls:MachineTile MachineName="{Binding Name}"
                                                       Status="{Binding Status}"
                                                       CpuLoad="{Binding CpuLoad}"/>

                             The plain {Binding Name} here is correct, because out here the
                             DataContext really is one LabMachine. Inside the control is
                             where you needed ElementName.

                             NOTE: Status and CpuLoad do not exist on the control yet, so
                             all three lines will not build. Comment those two out, run
                             with MachineName only, then put each one back as you add its
                             property in TODO 2 and TODO 4. -->
                        <controls:MachineTile MachineName="{Binding Name}" 
                                              Width="170" Height="120" Margin="0,0,12,12"
                                              Status="{Binding Status}"
                                              CpuLoad="{Binding CpuLoad}" />
                        <!-- -->
                        <!-- -->

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.Column="1"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="16" VerticalAlignment="Top">

            <!-- The detail pane is written for you. It is empty on screen because
                 DetailFields is collapsed and has no machine yet. Your handler in
                 TODO 10 is what switches it on. -->
            <StackPanel x:Name="DetailPanel">
                <TextBlock Text="Machine Details" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <TextBlock x:Name="DetailPlaceholder"
                           Text="Select a machine to see its details."
                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>

                <!-- DataContext starts as null on purpose. Without that, these five
                     bindings would inherit the window as their source at startup, look
                     for Room, Status, CpuLoad and LastSeen on it, not find them, and
                     print four binding errors to the Output window before you have
                     clicked anything. Your handler sets this DataContext. -->
                <StackPanel x:Name="DetailFields" Visibility="Collapsed" DataContext="{x:Null}">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Room, StringFormat='Room: {0}'}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding CpuLoad, StringFormat='CPU load: {0}%'}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding LastSeen, StringFormat='Last seen: {0:g}'}" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
