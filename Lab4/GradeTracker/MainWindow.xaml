<Window x:Class="GradeTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GradeTracker.ViewModels"
        Title="Grade Tracker" Height="640" Width="600">

    <!-- TODO Step 5 (View): set this window's DataContext to your ViewModel,
         then swap every x:Name and event handler (Click, SelectionChanged)
         below for a binding. The layout itself doesn't need to change. -->
    <Window.DataContext>
        <vm:GradeTrackerViewModel />
    </Window.DataContext>

    <StackPanel>
        <!-- Adding a student -->
        <StackPanel Orientation="Horizontal">
            <StackPanel>
                <TextBlock Text="Name:" Margin="10" FontSize="22" />
                <TextBlock Text="Grade:" Margin="10" FontSize="22" />
            </StackPanel>
            <StackPanel>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="10" FontSize="22" />
                <TextBox Text="{Binding GradeText, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="10" FontSize="22" />
            </StackPanel>
            <Button Content="Add Student" Command="{Binding AddStudentCommand}"
                    Width="160" Height="50" Margin="10" FontSize="22" />
        </StackPanel>

        <!-- Step 5 (View): the MessageBoxes are going away, so the user needs
             another way to find out what's wrong with their input. Add a red
             TextBlock here, bound to the message property from Step 4. -->
        <TextBlock Text="{Binding InputErrorMessage}" Foreground="Red" 
                   Margin="10, 0" FontSize="18" />

        <!-- The class list -->
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Students:" Margin="10" FontSize="22" />
            <ListBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}"
                     Width="260" Height="200" Margin="10" FontSize="22" />
            <Button Command="{Binding RemoveStudentCommand}" Content="Remove"
                    Width="110" Height="50" Margin="10" FontSize="22" VerticalAlignment="Top" />
        </StackPanel>

        <!-- Summary -->
        <StackPanel Orientation="Horizontal">
            <StackPanel>
                <TextBlock Text="Students:" Margin="10" FontSize="22" />
                <TextBlock Text="Class Average:" Margin="10" FontSize="22" />
                <TextBlock Text="Highest Grade:" Margin="10" FontSize="22" />
                <TextBlock Text="Lowest Grade:" Margin="10" FontSize="22" />
                <TextBlock Text="Top Student:" Margin="10" FontSize="22" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding NumberOfStudents}" Margin="10" FontSize="22" />
                <TextBlock Text="{Binding ClassAverage, StringFormat=0.0}" Margin="10" FontSize="22" />
                <TextBlock Text="{Binding HighestGrade, StringFormat=0.0}" Margin="10" FontSize="22" />
                <TextBlock Text="{Binding LowestGrade, StringFormat=0.0}" Margin="10" FontSize="22" />
                <TextBlock Text="{Binding TopStudent}" Margin="10" FontSize="22" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
