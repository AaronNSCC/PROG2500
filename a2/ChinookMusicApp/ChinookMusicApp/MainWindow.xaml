<Window x:Class="ChinookMusicApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChinookMusicApp"
        xmlns:vm="clr-namespace:ChinookMusicApp.ViewModels"
        xmlns:views="clr-namespace:ChinookMusicApp.Views"
        mc:Ignorable="d"
        Title="Chinook Music Store" Height="450" Width="800">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ArtistsViewModel}">
            <views:ArtistsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlbumsViewModel}">
            <views:AlbumsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TracksViewModel}">
            <views:TracksView />
        </DataTemplate>
    </Window.Resources>
    

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Background="WhiteSmoke">
            <Menu DockPanel.Dock="Left" VerticalAlignment="Center" Background="Transparent">
                <MenuItem Header="_File">
                    <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
                </MenuItem>
                <MenuItem Header="_Navigate">
                    <MenuItem Header="_Home" Command="{Binding ShowHomeCommand}" />
                    <MenuItem Header="_Artists" Command="{Binding ShowArtistsCommand}" />
                    <!-- Artists/Albums share same alt key so i changed to Al_bums to it'd be "b" instead -->
                    <MenuItem Header="Al_bums" Command="{Binding ShowAlbumsCommand}" />
                    <MenuItem Header="_Tracks" Command="{Binding ShowTracksCommand}" />
                </MenuItem>
            </Menu>
            <ToolBarTray DockPanel.Dock="Right" IsLocked="True" Background="Transparent">
                <ToolBar Background="Transparent">
                    <Button Command="{Binding ShowHomeCommand}" ToolTip="Go to the home page">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/home.png" Width="20" Height="20" />
                            <TextBlock Text="Home" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowArtistsCommand}" ToolTip="Go to the artists page">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/artists.png" Width="20" Height="20" />
                            <TextBlock Text="Artists" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowAlbumsCommand}" ToolTip="Go to the albums page">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/albums.png" Width="20" Height="20" />
                            <TextBlock Text="Albums" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowTracksCommand}" ToolTip="Go to the tracks page">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/tracks.png" Width="20" Height="20" />
                            <TextBlock Text="Tracks" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </ToolBar>
            </ToolBarTray>
        </DockPanel>
        <ContentControl Content="{Binding CurrentViewModel}" />
    </DockPanel>
    
</Window>
    