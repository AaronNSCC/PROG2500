<UserControl x:Class="ChinookMusicApp.Views.AlbumsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ChinookMusicApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Search:" Margin="0,0,6,0"/>
            <TextBox Width="220" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Sort:" Margin="16,0,6,0" />
            <ComboBox Width="140" ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSort}" />
            <Button Content="Reset" Margin="16,0,0,0" Command="{Binding ResetCommand}"
                    ToolTip="Clear the search and sort by title (A-Z)."/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="8,8,0,8" Text="{Binding Summary}" />
        <ListView ItemsSource="{Binding Albums}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="50"
                                    DisplayMemberBinding="{Binding AlbumId}"/>
                    <GridViewColumn Header="Title" Width="300"
                                    DisplayMemberBinding="{Binding Title}"/>
                    <GridViewColumn Header="Artist" Width="200"
                                    DisplayMemberBinding="{Binding Artist.Name}"/>
                    <GridViewColumn Header="Tracks" Width="70"
                                    DisplayMemberBinding="{Binding Tracks.Count}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
