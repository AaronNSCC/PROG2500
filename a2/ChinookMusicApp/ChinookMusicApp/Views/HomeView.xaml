<UserControl x:Class="ChinookMusicApp.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ChinookMusicApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- These styles are specific to the home page -->
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="SubtitleText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="HomeButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Margin" Value="4" />
        </Style>
    </UserControl.Resources>
    
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{Binding Welcome}" Style="{StaticResource TitleText}" />
        <TextBlock Text="Your one-stop shop for great music!" Style="{StaticResource SubtitleText}" />
        <TextBlock Text="Browse artists, albums and tracks using the toolbar or the menu."
                   Style="{StaticResource BodyText}" />
        <Separator Margin="0,10,0,10" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Artists" Command="{Binding DataContext.ShowArtistsCommand,
                    RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource HomeButton}"  />
            <Button Content="Albums" Command="{Binding DataContext.ShowAlbumsCommand,
                    RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource HomeButton}" />
            <Button Content="Tracks" Command="{Binding DataContext.ShowTracksCommand,
                    RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource HomeButton}" />
        </StackPanel>
    </StackPanel>
</UserControl>
