<Application x:Class="ChinookMusicApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ChinookMusicApp">
    <Application.Resources>
        <!-- app colors: palette by NYNÄ (@nynatrema) https://fr.pinterest.com/nynatrema/ -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#FFF8D2" />
        <SolidColorBrush x:Key="BarBrush" Color="#E6FBDA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3E5BA3" />
        <SolidColorBrush x:Key="HighlightBrush" Color="#84D175" />
        <SolidColorBrush x:Key="TextBrush" Color="#0C2D45" />

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
